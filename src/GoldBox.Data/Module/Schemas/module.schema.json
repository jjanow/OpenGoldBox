{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleManifest",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "rules": {
      "type": [
        "string",
        "null"
      ]
    },
    "vm": {
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "area": {
          "type": "integer"
        },
        "map": {
          "type": "integer"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "facing": {
          "type": "integer"
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "art": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "importer": {
          "type": [
            "string",
            "null"
          ]
        },
        "game": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "sha256"
            ]
          }
        }
      }
    },
    "credits": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "formatVersion",
    "id"
  ]
}
