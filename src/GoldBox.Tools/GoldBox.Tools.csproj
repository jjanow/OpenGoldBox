<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer console tools: run an ECL block headless and dump the VM trace (JSONL). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GoldBox.Tools</RootNamespace>
    <AssemblyName>goldbox-tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoldBox.Core\GoldBox.Core.csproj" />
    <ProjectReference Include="..\GoldBox.Data\GoldBox.Data.csproj" />
  </ItemGroup>

</Project>
